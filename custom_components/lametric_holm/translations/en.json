{
  "config": {
    "step": {
      "user": {
        "title": "HOLM LaMetric",
        "description": "An official LaMetric integration is already set up: its settings can be taken over.",
        "menu_options": {
          "reuse": "Take over the official LaMetric integration's settings",
          "manual": "Enter the address and API key"
        }
      },
      "manual": {
        "title": "Connect to the LaMetric",
        "description": "The API key is on developer.lametric.com, under “Devices”.",
        "data": {
          "host": "IP address or name",
          "api_key": "API key"
        }
      },
      "reuse": {
        "title": "Take over a LaMetric",
        "data": {
          "official_entry": "LaMetric"
        }
      }
    },
    "error": {
      "cannot_connect": "LaMetric unreachable at this address",
      "invalid_auth": "API key rejected"
    },
    "abort": {
      "already_configured": "This LaMetric is already set up (address and key updated)"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HOLM LaMetric options",
        "data": {
          "scan_interval": "State polling interval",
          "mydata_widget": "My Data app used for the continuous display"
        },
        "description": "The “My Data DIY” app ({package}) must be installed on the LaMetric and set to HTTP Push (local)."
      }
    }
  },
