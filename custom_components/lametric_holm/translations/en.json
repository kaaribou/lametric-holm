  "services": {
    "notify": {
      "name": "Notify",
      "description": "Sends a notification to the LaMetric: text, gauge or chart, sound, priority.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "message": {
          "name": "Message",
          "description": "Text (templates accepted)."
        },
        "icon": {
          "name": "Icon",
          "description": "LaMetric icon code (i1234, a1234) of the message."
        },
        "frames": {
          "name": "Frames",
          "description": "List of frames: {text, icon}, {type: goal, entity, end}, {type: chart, entity, hours}…"
        },
        "priority": {
          "name": "Priority",
          "description": "“Critical” shows even in standby."
        },
        "icon_type": {
          "name": "Pictogram",
          "description": "Pictogram shown before the notification."
        },
        "sound": {
          "name": "Sound",
          "description": "LaMetric sound, or MP3 address."
        },
        "repeat": {
          "name": "Sound repeats",
          "description": "0 = loop while the notification is shown."
        },
        "cycles": {
          "name": "Repeats",
          "description": "Number of passes through the frames; 0 = until cleared."
        },
        "lifetime": {
          "name": "Lifetime",
          "description": "Seconds before deletion if it couldn't be shown."
        },
        "ignore_night": {
          "name": "Ignore night mode",
          "description": "Sends even during night mode."
        }
      }
    },
    "dismiss": {
      "name": "Clear notifications",
      "description": "Clears the shown notification, a specific one or all.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "all": {
          "name": "All",
          "description": "Clears the whole queue."
        },
        "id": {
          "name": "ID",
          "description": "Notification to clear."
        }
      }
    },
    "activate_app": {
      "name": "Show an app",
      "description": "Switches the LaMetric to an app.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "app": {
          "name": "App",
          "description": "Display name (Clock, Weather, Radio…)."
        },
        "package": {
          "name": "Package",
          "description": "App ID (com.lametric.weather)."
        },
        "widget": {
          "name": "Widget",
          "description": "Widget ID, if the app has several."
        }
      }
    },
    "app_action": {
      "name": "App action",
      "description": "Triggers an action of a LaMetric app.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "package": {
          "name": "Package",
          "description": "App ID."
        },
        "action": {
          "name": "Action",
          "description": "Action ID."
        },
        "widget": {
          "name": "Widget",
          "description": "Widget ID."
        },
        "params": {
          "name": "Parameters",
          "description": "Action parameters."
        },
        "activate": {
          "name": "Show the app",
          "description": "Switches to the app after the action."
        }
      }
    },
    "alarm": {
      "name": "Alarm",
      "description": "Sets the clock's alarm.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "enabled": {
          "name": "On",
          "description": "Turns the alarm on or off."
        },
        "time": {
          "name": "Time",
          "description": "Alarm time."
        },
        "wake_with_radio": {
          "name": "Wake up to radio",
          "description": "Alarm with the radio."
        },
        "activate": {
          "name": "Show the clock",
          "description": "Switches to the clock."
        }
      }
    },
    "timer": {
      "name": "Timer",
      "description": "Starts, pauses or resets the timer.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "action": {
          "name": "Action",
          "description": "Timer action."
        },
        "duration": {
          "name": "Duration",
          "description": "Timer duration (on start)."
        }
      }
    },
    "stopwatch": {
      "name": "Stopwatch",
      "description": "Controls the stopwatch.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "action": {
          "name": "Action",
          "description": "Stopwatch action."
        }
      }
    },
    "radio": {
      "name": "Radio",
      "description": "Controls the LaMetric's radio.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "action": {
          "name": "Action",
          "description": "Radio action."
        }
      }
    },
    "clockface": {
      "name": "Clock face",
      "description": "Changes the clock face or puts an icon on it.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "type": {
          "name": "Face",
          "description": "Predefined face."
        },
        "icon": {
          "name": "Icon",
          "description": "Icon instead of the face (data:image… or code)."
        }
      }
    },
    "push_frames": {
      "name": "Show in My Data",
      "description": "Replaces the programs' frames in the My Data app for a few minutes.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "message": {
          "name": "Message",
          "description": "Text (templates accepted)."
        },
        "icon": {
          "name": "Icon",
          "description": "LaMetric icon code."
        },
        "frames": {
          "name": "Frames",
          "description": "List of frames, as for Notify."
        },
        "minutes": {
          "name": "Duration",
          "description": "Minutes shown before going back to the programs."
        },
        "activate": {
          "name": "Show the app",
          "description": "Switches the LaMetric to My Data."
        }
      }
    },
    "programme": {
      "name": "Program",
      "description": "Enables, disables or shows a program right away.",
      "fields": {
        "device": {
          "name": "LaMetric",
          "description": "Optional if there is only one."
        },
        "programme": {
          "name": "Program",
          "description": "Program name or ID."
        },
        "action": {
          "name": "Action",
          "description": "What to do."
        }
      }
    }
  }
